<div class="box">
    <div class="icons">
        <a class="fas fa-shopping-cart" href="#"></a>
        <a class="fas fa-heart" href="#"></a>
        <a class="fas fa-eye" href="#"></a>
    </div>
    <div class="image">
        <img alt="" src="<%= image %>" />
    </div>
    <div class="content">
        <h3>
            <%= title %>
        </h3>
        <div class="price">
            <%= price %>
        </div>
        <div class="stars">
            <% for (let i=0; i < stars; i++) { %>
                <i class="fas fa-star"></i>
                <% } %>
        </div>
    </div>
</div>